#
# Verify replacement of an output phi, creation of input phis, and dead-phi cleanup.
# The moved suffix also preserves a shared input and remaps steady and last-stage uses.
#
# RUN: llc -mtriple=aie2ps -run-pass=aie-outer-loop-stage-split \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

--- |
  define void @phi_rewrites() {
  entry:
    unreachable
  stage0.top:
    unreachable
  steady.stage1.top:
    unreachable
  steady.inner:
    unreachable
  steady.stage1.bottom.and.stage0.top:
    unreachable, !llvm.loop !0
  lastiter.stage1.top:
    unreachable
  lastiter.inner:
    unreachable
  lastiter.stage1.bottom:
    unreachable
  exit:
    unreachable
  }

  !0 = distinct !{!0, !1, !2}
  !1 = !{!"llvm.loop.hint.aie_outerloop_pipeliner_success", i64 1}
  !2 = !{!"llvm.loop.hint.aie_outerloop_pipeliner_deferred_stage_split", i64 1}
...
