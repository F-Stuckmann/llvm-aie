#
# Capture the all-stage-0 form with paired long-latency loads and result PHIs.
# The stage-split implementation will use this as its focused input fixture.
#
# RUN: llc -mtriple=aie2ps -run-pass=aie-outer-loop-stage-split \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

--- |
  define void @stage0_dag_collection() {
  entry:
    unreachable
  stage0.top:
    unreachable
  steady.stage1.top:
    unreachable
  steady.inner:
    unreachable
  steady.stage1.bottom.and.stage0.top:
    unreachable, !llvm.loop !0
  lastiter.stage1.top:
    unreachable
  lastiter.inner:
    unreachable
  lastiter.stage1.bottom:
    unreachable
  exit:
    unreachable
  }

  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.hint.aie_outerloop_pipeliner_success", i64 1}
...
