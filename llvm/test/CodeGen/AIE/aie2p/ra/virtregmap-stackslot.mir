# RUN: llc -O2 -mtriple=aie2p -verify-machineinstrs \
# RUN:     -start-before=virtregrewriter -o - %s \
# RUN:    | FileCheck %s --check-prefix=STACKSLOT

# Test that VirtRegMap correctly handles stack-slot fields for spilled
# virtual registers. This test provides a MIR file with explicit stack-slot
# assignments and verifies compilation can proceed.

---
name:            test_virtregmap_stackslot
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
registers:
  - { id: 0, class: ep, assigned-register: '$p0' }
  - { id: 1, class: ep, stack-slot: 0 }
  - { id: 2, class: ep, assigned-register: '$p1' }
body:             |
  bb.0.entry:
    liveins: $p0, $p1

    ; STACKSLOT-LABEL: test_virtregmap_stackslot:
    ; STACKSLOT: {{  }}ret lr

    %0:ep = COPY $p0
    %1:ep = COPY $p1
    %2:ep = COPY %0
    PseudoRET implicit $lr, implicit %1, implicit %2
...
