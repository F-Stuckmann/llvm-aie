# RUN: llc -O2 -mtriple=aie2p -verify-machineinstrs -start-before=greedy \
# RUN:     -stop-before=virtregrewriter %s -o - \
# RUN:    | FileCheck %s --check-prefix=SERIALIZE

# Test that VirtRegMap assignments are correctly serialized to MIR after
# register allocation but before virtregrewriter. This verifies the assigned-register
# field appears in the output.

---
name:            test_virtregmap_serialize
tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $p0, $p1

    ; SERIALIZE-LABEL: name: test_virtregmap_serialize
    ; SERIALIZE: registers:
    ; SERIALIZE-NEXT:   - { id: 0, class: ep{{.*}}assigned-register:
    ; SERIALIZE:   - { id: 1, class: ep{{.*}}assigned-register:

    %0:ep = COPY $p0
    %1:ep = COPY $p1
    PseudoRET implicit $lr, implicit %0, implicit %1
...
